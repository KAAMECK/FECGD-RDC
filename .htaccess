Options -Indexes
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /FECGD-DRC/
# Les anciennes adresses de gestion rejoignent la nouvelle administration.
RewriteRule ^(?:site/wordpress|simulation)/(?:wp-admin(?:/.*)?|wp-login\.php)$ admin/ [R=302,L]
RewriteRule ^simulation/?(.*)$ $1 [R=302,L]
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
</IfModule>
